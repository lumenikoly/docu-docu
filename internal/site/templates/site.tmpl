{{define "shell"}}<!doctype html>
<html lang="{{.Lang}}"{{.HTMLAttributes}}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
{{if .Revision}}  <meta name="toudocu-revision" content="{{.Revision}}">
{{end}}
  <meta name="description" content="{{.Description}}">
  <title>{{.Title}}</title>
  <link rel="icon" href="{{.Favicon}}">
  <script src="{{.AppearanceJS}}"></script>
  <link rel="stylesheet" href="{{.PortalCSS}}">
{{with .ExtraStyles}}  {{.}}
{{end}}{{if .ServeCSS}}  <link rel="stylesheet" href="{{.ServeCSS}}">
{{end}}
  <script id="toudocu-page" type="application/json">{{.Bootstrap}}</script>
  <script type="module" src="{{.PortalJS}}"></script>
{{if .ServeJS}}  <script type="module" src="{{.ServeJS}}" data-toudocu-serve-navigation></script>
{{end}}
</head>
<body data-root-prefix="{{.RootPrefix}}" data-task-filter="all">
  <a class="skip-link" href="#main-content">{{.UI.Text "skip.content"}}</a>
  {{.Header}}
{{if .ServeJS}}  <div data-td-island="discussions" data-td-island-instance="project-discussions" data-td-island-activation="activated"><p data-td-island-error hidden role="alert">{{.UI.Text "core.portal.080" "React"}}</p></div>
{{end}}
  <div class="site-layout">
    <aside class="sidebar">{{.Navigation}}</aside>
    <div class="main-area">
      <main id="main-content" class="page-grid{{.MainClass}}"><div class="page-content">{{.Content}}</div>{{.TOC}}</main>
      <footer class="site-footer">{{.Footer}}</footer>
    </div>
  </div>
</body>
</html>{{end}}

{{define "workspace"}}<!doctype html>
<html lang="{{.Lang}}"{{.HTMLAttributes}}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{.Title}}</title>
  <link rel="icon" href="{{.Favicon}}">
  {{if .AppearanceJS}}<script src="{{.AppearanceJS}}"></script>{{end}}
  {{range .Styles}}<link rel="stylesheet" href="{{.}}">{{end}}
  <script id="toudocu-page" type="application/json">{{.Bootstrap}}</script>
  {{range .Scripts}}<script {{if .Module}}type="module"{{else}}defer{{end}} src="{{.URL}}"></script>{{end}}
</head>
{{.Body}}
</html>{{end}}

{{define "editor"}}<body class="workspace-body editor-body">
<a class="editor-skip" href="#editor-workspace">{{.UI.Text "skip.editor"}}</a>
<div class="editor-shell">
  {{.Header}}
  <div data-editor-root></div>
</div>
</body>{{end}}

{{define "changes"}}<body class="workspace-body changes-body">
<a class="skip-link" href="#changes-main">{{.UI.Text "skip.changes"}}</a>
{{.Header}}
<main id="changes-main" class="changes-workspace">
  <section class="changes-overview" aria-labelledby="changes-title"><h1 id="changes-title">{{.UI.Text "changes.title"}}</h1><details class="changes-range-details" data-range-details><summary data-range-summary>{{.UI.Text "changes.rangeSummary"}}</summary><div class="changes-range"><p data-range-meta>{{.UI.Text "changes.preparingGit"}}</p><label>{{.UI.Text "changes.base"}}<input type="text" value="HEAD" data-base spellcheck="false"></label><label>{{.UI.Text "changes.branchBase"}}<input type="text" data-branch-base placeholder="main" spellcheck="false"></label><label>{{.UI.Text "changes.target"}}<select data-target><option value="working-tree">{{.UI.Text "changes.workingTree"}}</option><option value="index">index</option><option value="HEAD">HEAD</option><option value="revision">{{.UI.Text "changes.gitRevision"}}</option></select></label><label data-target-revision-wrap hidden>{{.UI.Text "changes.targetRevision"}}<input type="text" data-target-revision spellcheck="false" placeholder="abc1234"></label><button type="button" class="changes-button" data-apply-range>{{.UI.Text "changes.apply"}}</button></div></details><p class="changes-summary" data-summary>{{.UI.Text "changes.preparing"}}</p><div class="changes-review-actions"><button type="button" class="changes-button secondary" data-mobile-files aria-expanded="false">{{.UI.Text "changes.files"}}</button></div></section>
  <div class="changes-notice" data-stale hidden role="status">{{.UI.Text "changes.workspaceChanged"}}</div>
  <div class="changes-notice" data-open-file-stale hidden role="alert"><strong>{{.UI.Text "changes.openFileChanged"}}</strong> {{.UI.Text "changes.viewPreserved"}} <button type="button" class="changes-button secondary" data-refresh-open-file>{{.UI.Text "changes.refresh"}}</button></div>
  <div class="changes-split"><aside class="changes-list-panel" data-files-panel aria-label="{{.UI.Text "changes.files"}}" role="navigation"><div class="changes-list-heading"><h2>{{.UI.Text "changes.files"}}</h2><span data-result-count></span><button type="button" data-files-close aria-label="{{.UI.Text "changes.closeFiles"}}">×</button></div><div class="changes-list-filters"><label class="changes-search"><span>{{.UI.Text "changes.search"}}</span><input type="search" data-search placeholder="{{.UI.Text "changes.pathOrTitle"}}"></label><label><span>{{.UI.Text "changes.status"}}</span><select data-status><option value="">{{.UI.Text "changes.all"}}</option><option value="added">{{.UI.Text "changes.added"}}</option><option value="untracked">{{.UI.Text "changes.untracked"}}</option><option value="modified">{{.UI.Text "changes.modified"}}</option><option value="deleted">{{.UI.Text "changes.deleted"}}</option><option value="renamed">{{.UI.Text "changes.renamed"}}</option></select></label><label><span>{{.UI.Text "changes.type"}}</span><select data-scope><option value="">{{.UI.Text "changes.allFiles"}}</option><option value="documents">{{.UI.Text "changes.documents"}}</option><option value="other">{{.UI.Text "changes.otherFiles"}}</option></select></label></div><div class="changes-file-list" data-file-list></div><button type="button" class="changes-linked-add" data-linked-file-open>{{.UI.Text "changes.linkFile"}}</button></aside><section class="changes-detail" data-detail aria-live="polite"><div class="changes-empty" data-ui-state="empty"><h2>{{.UI.Text "changes.none"}}</h2><p>{{.UI.Text "changes.adjustFilters"}}</p></div></section></div><button type="button" data-discussions-scrim data-discussions-scrim-mount hidden></button><aside id="project-discussions-panel" data-discussions-panel data-discussions-panel-mount hidden></aside>
</main>
<dialog class="review-composer" data-review-composer><form method="dialog" data-review-form><header><div><strong>{{.UI.Text "changes.newComment"}}</strong><span data-review-target-summary></span></div><button value="cancel" formnovalidate aria-label="{{.UI.Text "changes.close"}}">×</button></header><label>{{.UI.Text "core.portal.092"}}<select data-review-intent><option value="question">{{.UI.Text "core.portal.093"}}</option><option value="change_request">{{.UI.Text "core.portal.094"}}</option></select></label><label>{{.UI.Text "changes.comment"}}<textarea data-review-message rows="4" maxlength="65536" required></textarea></label><p class="form-error" data-review-error role="alert"></p><footer><button value="cancel" formnovalidate>{{.UI.Text "editor.cancel"}}</button><button type="submit" class="changes-button" value="default">{{.UI.Text "core.portal.047"}} <span class="shortcut-hint">Ctrl/⌘ Enter</span></button></footer></form></dialog>
<dialog class="review-composer review-delete-confirm" data-review-delete-confirm><form method="dialog" data-review-delete-form><header><strong>{{.UI.Text "changes.deleteDiscussion"}}</strong></header><p>{{.UI.Text "changes.deleteWarning"}}</p><footer><button value="cancel">{{.UI.Text "editor.cancel"}}</button><button type="submit" class="changes-button danger">{{.UI.Text "changes.delete"}}</button></footer></form></dialog>
<dialog class="review-file-picker" data-file-picker><form method="dialog"><header><strong>{{.UI.Text "changes.linkFile"}}</strong><button value="cancel" aria-label="{{.UI.Text "changes.close"}}">×</button></header><label>{{.UI.Text "changes.pathOrTitle"}}<input type="search" data-file-picker-query autocomplete="off"></label><div data-file-picker-results></div></form></dialog>
<div class="changes-toast" data-changes-toast role="status" aria-live="polite"><span data-toast-message></span></div>
</body>{{end}}

{{define "api-docs"}}<body><div id="swagger-ui" data-specs="{{.SpecsJSON}}"></div></body>{{end}}
